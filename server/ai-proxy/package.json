{
  "name": "gamada-ai-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GAMADA Demo Kit AI proxy (Hono): /api/ai/health, /api/ai/chat (SSE), /api/ai/extract",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/node.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/node.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/selftest.ts",
    "dev:mock": "tsx watch src/node.ts --mock",
    "start:mock": "node dist/src/node.js --mock"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
