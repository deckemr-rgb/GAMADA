# GAMADA AI proxy — copy to .env and fill in. Never commit .env.

# --- Claude API ---------------------------------------------------------------
# Without a key (and without AI_MOCK) the proxy runs but reports live:false; the site stays on simulation.
ANTHROPIC_API_KEY=
# Optional: gateway / self-hosted endpoint (SDK default when empty)
ANTHROPIC_BASE_URL=
# Chat model (Sapa Warga, Toko Autopilot, …)
AI_MODEL_FAST=claude-haiku-5-5
# Briefing, minutes and analysis (Meja Pimpinan, Naskah Pintar, Radar Isu, Awas Belanja, …)
AI_MODEL_SMART=claude-sonnet-5-5
# Vision extraction (/api/ai/extract); defaults to AI_MODEL_SMART
AI_MODEL_EXTRACT=
# low | medium | high — low keeps the first token well inside the site's 10 s fallback window
AI_EFFORT_FAST=low
AI_EFFORT_SMART=low
# Per model turn, thinking included (256–16000)
AI_MAX_OUTPUT_TOKENS=2048
# Model turns per chat answer (tool call + follow-up text); 1–6
AI_MAX_TOOL_ROUNDS=3

# --- Guard rails --------------------------------------------------------------
# Billable-equivalent tokens per day (resets 00:00 WIB). 0 = unlimited.
AI_DAILY_TOKEN_BUDGET=2000000
# Requests per client IP per window (chat + extract). Default 20 per 600 s (1000 when AI_MOCK=1).
RATE_LIMIT_PER_IP=20
RATE_LIMIT_WINDOW_SEC=600
# Comma-separated exact origins of the site. "*" = any origin (not for production).
ALLOWED_ORIGINS=https://gamada.id,https://www.gamada.id,http://localhost:5173,http://127.0.0.1:5173
# Read the client IP from X-Forwarded-For (set 1 only behind a proxy you control, e.g. Caddy)
TRUST_PROXY=0

# --- Shared counters (optional) -----------------------------------------------
# Upstash-compatible Redis REST URL (https://…). Without it counters live in memory.
REDIS_URL=
REDIS_TOKEN=

# --- Testing ------------------------------------------------------------------
# 1 = deterministic fake answers, no key, no network (Playwright)
AI_MOCK=0
AI_MOCK_DELAY_MS=15
# info | silent
LOG_LEVEL=info

# --- Server (node adapter / Docker) ---------------------------------------------
PORT=8787
HOST=0.0.0.0
# docker-compose + Caddy
AI_DOMAIN=ai.example.com
