si rumah","en":"House location sketch"},{"id":"Rekening listrik / bukti alamat","en":"Utility bill / proof of address"}],"slaDays":14,"channel":"dinas","opdId":"perumda-am","fee":{"id":"Biaya pasang sesuai tarif Perumda","en":"Connection fee per utility tariff"}},{"id":"aduan-pju","name":{"id":"Perbaikan penerangan jalan umum (PJU)","en":"Street-light repair"},"requirements":[{"id":"Lokasi titik lampu (foto + peta)","en":"Light-pole location (photo + map)"},{"id":"Kontak pelapor","en":"Reporter contact"}],"slaDays":7,"channel":"online","opdId":"dishub","fee":{"id":"Gratis (tidak dipungut biaya)","en":"Free of charge"}}],"languages":{"primary":"id","regional":["su"],"speechCodes":["su-ID","id-ID"],"samples":{"greetings":[{"lang":"su","text":"Wilujeng enjing, Akang, Teteh. Aya nu tiasa dibantos?","id":"Selamat pagi, Bapak/Ibu. Ada yang bisa dibantu?","en":"Good morning. How can we help you?"},{"lang":"su","text":"Punten, abdi bade lapor.","id":"Permisi, saya mau melapor.","en":"Excuse me, I would like to file a report."},{"lang":"su","text":"Kumaha damang? Aya nu tiasa dibantos?","id":"Apa kabar? Ada yang bisa dibantu?","en":"How are you? Is there anything we can help with?"},{"lang":"su","text":"Hatur nuhun pisan, laporan Akang/Teteh parantos kacatet.","id":"Terima kasih banyak, laporan Anda sudah tercatat.","en":"Thank you very much, your report has been recorded."},{"lang":"su","text":"Wilujeng sumping di layanan warga Kota Bandung.","id":"Selamat datang di layanan warga Kota Bandung.","en":"Welcome to the Bandung city citizen service."}],"complaintTemplates":[{"id":"banjir-cileuncang","lang":"su","category":"banjir","text":"Kang, cileuncang di Bandung Kidul geus asup ka imah, jerona geus sabeuteung. Kolot jeung barudak kudu diungsikeun ayeuna, tulung kirim bantuan.","translation":{"id":"Kang, genangan air (cileuncang) di Bandung Kidul sudah masuk rumah, dalamnya sudah sepinggang. Lansia dan anak-anak harus diungsikan sekarang, tolong kirim bantuan.","en":"Kang, the street flooding (cileuncang) in Bandung Kidul has entered homes and is waist-deep. The elderly and children must be evacuated now, please send help."},"urgency":"tinggi"},{"id":"banjir-cikapundung","lang":"su","category":"banjir","text":"Punten, cai Cikapundung geus naek, jalan di sisi walungan di Regol geus kakeueum. Upami engke wengi hujan deui, imah warga tiasa kalebetan cai. Nyuhunkeun dipantau.","translation":{"id":"Permisi, air Sungai Cikapundung sudah naik, jalan di tepi sungai di Regol sudah tergenang. Kalau nanti malam hujan lagi, rumah warga bisa kemasukan air. Mohon dipantau.","en":"Excuse me, the Cikapundung is rising and the riverside road in Regol is under water. If it rains again tonight, water could enter people's homes. Please monitor it."},"urgency":"sedang"},{"id":"banjir-gorong","lang":"su","category":"banjir","text":"Gorong-gorong di hareupeun pasar mampet ku runtah, unggal hujan gede cileuncang nepi ka tuur. Lamun teu gancang dibersihan, peuting ieu bisa caah deui.","translation":{"id":"Gorong-gorong di depan pasar tersumbat sampah, setiap hujan deras genangan sampai selutut. Kalau tidak segera dibersihkan, malam ini bisa banjir lagi.","en":"The culvert in front of the market is blocked with rubbish and every heavy rain floods the street knee-deep. If it is not cleared soon, it could flood again tonight."},"urgency":"tinggi"},{"id":"banjir-pasca","lang":"su","category":"banjir","text":"Caah geus tilu poe can saat, sumur warga kiruh kabeh. Butuh cai beresih jeung ubar, utamana keur barudak jeung kolot.","translation":{"id":"Banjir sudah tiga hari belum surut, sumur warga keruh semua. Butuh air bersih dan obat-obatan, terutama untuk anak-anak dan lansia.","en":"The flood has not receded for three days and all the wells are muddy. We need clean water and medicine, especially for children and the elderly."},"urgency":"sedang"},{"id":"jalan-gedebage","lang":"su","category":"jalan-rusak","text":"Jalan di Gedebage loba nu bolong gede, geus loba nu tikusruk naek motor. Mun hujan, liangna katutupan cai jadi teu katempo. Tulung gancang dioméan.","translation":{"id":"Jalan di Gedebage banyak lubang besar, sudah banyak pengendara motor yang jatuh. Kalau hujan, lubangnya tertutup air jadi tidak kelihatan. Tolong segera diperbaiki.","en":"The road in Gedebage is full of big potholes and many motorcyclists have fallen. When it rains the holes fill with water and cannot be seen. Please repair it soon."},"urgency":"sedang"},{"id":"jalan-ambles","lang":"su","category":"jalan-rusak","text":"Jalan di sisi walungan Cikapundung di Coblong amblas satengahna, rekahna beuki lega. Mun aya mobil gede ngaliwat bisa runtuh. Tulung gancang dipasangan tanda bahaya.","translation":{"id":"Jalan di tepi Sungai Cikapundung di Coblong amblas separuh, retakannya makin lebar. Kalau ada kendaraan besar lewat bisa runtuh. Tolong segera dipasang tanda bahaya.","en":"The road along the Cikapundung in Coblong has half subsided and the crack keeps widening; it could collapse under a heavy vehicle. Please put up warning signs urgently."},"urgency":"tinggi"},{"id":"sampah-pasar","lang":"su","category":"sampah","text":"Runtah di sisi jalan deukeut pasar geus numpuk saminggu teu diangkut, bauna teu kaampeuh jeung loba laleur. Mun hujan, runtahna palid ka solokan.","translation":{"id":"Sampah di pinggir jalan dekat pasar sudah menumpuk seminggu tidak diangkut, baunya tidak tertahankan dan banyak lalat. Kalau hujan, sampahnya hanyut ke selokan.","en":"Rubbish by the road near the market has piled up for a week without collection; it stinks and draws flies. When it rains it washes into the drains."},"urgency":"sedang"},{"id":"pju-mati","lang":"su","category":"pju","text":"Lampu jalan di parapatan gang geus paeh dua minggu, peuting poek mongkleng. Loba nu sieun ngaliwat, hariwang aya maling.","translation":{"id":"Lampu jalan di perempatan gang sudah mati dua minggu, malam gelap gulita. Banyak yang takut lewat, khawatir ada pencuri.","en":"The street light at the alley crossing has been out for two weeks and it is pitch dark at night. People are afraid to pass, worried about thieves."},"urgency":"rendah"},{"id":"air-pdam","lang":"su","category":"air-bersih","text":"Cai PDAM di imah abdi geus tilu poe teu ngocor, sakalina ngocor ngan peuting jeung kiruh. Tulung pipana dipariksa.","translation":{"id":"Air PDAM di rumah saya sudah tiga hari tidak mengalir, sekalinya mengalir hanya malam hari dan keruh. Tolong pipanya dicek.","en":"The piped water at my house has not run for three days; when it does, only at night and muddy. Please check the pipes."},"urgency":"sedang"},{"id":"pohon-tumbang","lang":"su","category":"pohon-tumbang","text":"Tangkal gede di sisi jalan rubuh katebak angin, nutupan jalan jeung kabel listrik pegat. Kendaraan teu bisa ngaliwat pisan.","translation":{"id":"Pohon besar di pinggir jalan tumbang diterjang angin, menutup jalan dan kabel listrik putus. Kendaraan sama sekali tidak bisa lewat.","en":"A big tree by the road was blown down, blocking the road and snapping the power line. Vehicles cannot get through at all."},"urgency":"tinggi"},{"id":"pungli-kelurahan","lang":"su","category":"pungli","text":"Punten, Pak. Waktu ngurus surat pindah di kantor kelurahan, abdi dipenta duit saratus lima puluh rebu tanpa kuitansi. Naha leres aya biayana?","translation":{"id":"Permisi, Pak. Waktu mengurus surat pindah di kantor kelurahan, saya dimintai uang seratus lima puluh ribu tanpa kuitansi. Apakah memang ada biayanya?","en":"Excuse me, Sir: when I processed a moving letter at the kelurahan office I was asked for 150,000 rupiah without a receipt. Is there really a fee?"},"urgency":"sedang"},{"id":"puskesmas-antre","lang":"su","category":"kesehatan","text":"Antrian di puskesmas panjang pisan, dokterna ngan hiji. Budak abdi geus tilu poe panas, ti isuk nepi ka beurang can kabagean.","translation":{"id":"Antrean di puskesmas panjang sekali, dokternya hanya satu. Anak saya demam sudah tiga hari, dari pagi sampai siang belum dapat giliran.","en":"The queue at the health centre is very long and there is only one doctor. My child has had a fever for three days and has waited from morning to noon without being seen."},"urgency":"sedang"},{"id":"dbd-rt","lang":"su","category":"kesehatan","text":"Di RT dieu geus aya tilu budak katerap demam berdarah minggu ieu. Tulung di-fogging jeung dipariksa jentikna.","translation":{"id":"Di RT sini sudah ada tiga anak kena demam berdarah minggu ini. Tolong dilakukan fogging dan pemeriksaan jentik.","en":"Three children in our neighbourhood have caught dengue this week. Please carry out fogging and a larva check."},"urgency":"tinggi"},{"id":"ktp-belum-jadi","lang":"su","category":"adminduk","text":"Abdi parantos ngurus KTP-el ti dua bulan kapengker, dugi ka ayeuna teu acan réngsé, saurna blangkona seep. Iraha tiasa dicandak?","translation":{"id":"Saya sudah mengurus KTP-el sejak dua bulan lalu, sampai sekarang belum jadi, katanya blankonya habis. Kapan bisa diambil?","en":"I applied for my e-ID two months ago and it is still not ready; they say the blank cards ran out. When can I collect it?"},"urgency":"rendah"},{"id":"bansos-hilang","lang":"su","category":"bansos","text":"Nini abdi geus kolot jeung hirup nyorangan, naha ngaranna leungit tina daftar bansos bulan ieu? Padahal bulan kamari masih meunang. Tulung dipariksa.","translation":{"id":"Nenek saya sudah tua dan hidup sendiri, kenapa namanya hilang dari daftar bansos bulan ini? Padahal bulan lalu masih dapat. Tolong dicek.","en":"My grandmother is old and lives alone, so why has her name disappeared from this month's social-assistance list? She received it last month. Please check."},"urgency":"sedang"},{"id":"sekolah-atap","lang":"su","category":"sekolah","text":"Hateup kelas SD di lingkungan abdi bocor jeung kaina geus rapuh, barudak sieun mun hujan gede. Tulung gancang dioméan samemeh rubuh.","translation":{"id":"Atap kelas SD di lingkungan saya bocor dan kayunya sudah rapuh, anak-anak takut kalau hujan deras. Tolong segera diperbaiki sebelum roboh.","en":"The primary-school classroom roof in my neighbourhood leaks and the timber is rotten; the children are scared in heavy rain. Please fix it before it collapses."},"urgency":"tinggi"}]}},"weather":{},"branding":{"emblem":"generic","primaryHue":205},"scenario":{"floodRiverId":"cikapundung","floodKecamatanIds":["bandung-kidul","regol","lengkong"],"shopMarketId":"pasar-kordon"},"sources":[{"layer":"kecamatan","name":"HDX COD-AB Indonesia — batas kecamatan (adm3)","url":"https://data.humdata.org/dataset/cod-ab-idn","license":"CC BY-IGO","year":2020,"note":"BPS / OCHA ROAP; disederhanakan (Douglas-Peucker topologis, 4 desimal) oleh tools/region/build-bandung.mjs. Kode Kemendagri per kecamatan: https://id.wikipedia.org/wiki/Daftar_kecamatan_dan_kelurahan_di_Kota_Bandung (Permendagri 72/2019)"},{"layer":"desa","name":"HDX COD-AB Indonesia — batas kelurahan (adm4)","url":"https://data.humdata.org/dataset/cod-ab-idn","license":"CC BY-IGO","year":2020,"note":"151 kelurahan (kota: tidak ada desa)"},{"layer":"stats","name":"Angka simulasi berskala realistis: penduduk per kecamatan, KK, luas, ketinggian","url":"tools/region/data/sim-bandung.mjs","license":"Angka simulasi GAMADA (bukan statistik resmi)","year":2025,"note":"Angka simulasi untuk demo, dibulatkan dari skala data publik; bukan statistik resmi. Penduduk dibulatkan ke 100 (kecamatan) / 1.000 (total), KK ke 1.000, luas ke km² bulat, ketinggian maksimum ke 5 m; skala mengacu ke publikasi BPS Kota Bandung (dikutip, dibulatkan)."},{"layer":"economy","name":"Struktur ekonomi simulasi (persen bulat, Σ 100)","url":"tools/region/data/sim-bandung.mjs","license":"Angka simulasi GAMADA (bukan statistik resmi)","year":2025,"note":"Angka simulasi untuk demo, dibulatkan dari skala data publik; bukan statistik resmi"},{"layer":"prices","name":"Harga dasar simulasi","url":"tools/region/data/sim-bandung.mjs","license":"Angka simulasi GAMADA (bukan statistik resmi)","year":2026,"note":"harga dasar simulasi untuk demo, dipilih tim GAMADA agar wajar untuk kota besar di Jawa Barat tahun 2026, dibulatkan ke Rp 50/100; bukan harga resmi. Dunia simulasi menambah selisih per pasar dan fluktuasi harian."},{"layer":"rivers","name":"OpenStreetMap — sungai","url":"https://www.openstreetmap.org/copyright","license":"ODbL 1.0 · © OpenStreetMap contributors","year":2026,"note":"nama \"Ci X\" di OSM ditulis \"CiX\" (Cikapundung)"},{"layer":"roads","name":"OpenStreetMap — jalan tol/trunk/primary/secondary","url":"https://www.openstreetmap.org/copyright","license":"ODbL 1.0 · © OpenStreetMap contributors","year":2026},{"layer":"landmarks","name":"OpenStreetMap — pasar, balai kota, kantor kecamatan, RS, puskesmas, sekolah, titik kumpul","url":"https://www.openstreetmap.org/copyright","license":"ODbL 1.0 · © OpenStreetMap contributors","year":2026,"note":"sampel: satu puskesmas per kecamatan, satu SMP/SMA/SMK negeri per kecamatan (maks. 14), RS maks. 8; titik kumpul = emergency=assembly_point di OSM (tanpa nama), dinamai menurut kecamatannya"},{"layer":"hazards.flood","name":"Zona risiko banjir turunan (banjir cileuncang + luapan Cikapundung)","url":"tools/region/build-bandung.mjs","license":"Turunan dari HDX (CC BY-IGO) dan OSM (ODbL)","year":2026,"note":"zona risiko turunan (simulasi), bukan peta resmi BNPB. Jarak ke Cikapundung (dan sungai lain, bobot 0.55) × faktor dataran rendah (ketinggian maksimum simulasi per kecamatan); riskFlood per kecamatan dari derivasi yang sama"},{"layer":"hazards.landslide","name":"Zona risiko longsor turunan (lereng utara)","url":"tools/region/build-bandung.mjs","license":"Turunan dari HDX (CC BY-IGO)","year":2026,"note":"zona risiko turunan (simulasi), bukan peta resmi BNPB. riskLandslide per kecamatan dari ketinggian maksimum simulasi"},{"layer":"mainSector","name":"Sektor utama per kecamatan","url":"tools/region/content/bandung.mjs","license":"Konten editorial GAMADA","note":"ringkasan editorial (simulasi), bukan statistik per kecamatan"},{"layer":"opd","name":"Daftar OPD (nomenklatur umum)","url":"tools/region/content/bandung.mjs","license":"Konten editorial GAMADA","note":"nomenklatur umum perangkat daerah, bukan SOTK resmi Pemkot Bandung"},{"layer":"services","name":"Layanan & persyaratan","url":"tools/region/content/bandung.mjs","license":"Konten editorial GAMADA","note":"ringkasan umum persyaratan nasional; cek ketentuan resmi sebelum dipakai"},{"layer":"languages","name":"Sapaan & template aduan Basa Sunda (contoh)","url":"tools/region/content/bandung.mjs","license":"Konten editorial GAMADA","note":"contoh fiktif untuk demo, ditulis tim GAMADA, belum diperiksa penutur asli; nama tempat nyata"},{"layer":"umkmCount","name":"TODO: jumlah UMKM belum diisi","url":"tools/region/build-bandung.mjs","license":"-","note":"field economy.umkmCount sengaja dikosongkan; bila dibutuhkan, isi dengan angka simulasi"}]}
