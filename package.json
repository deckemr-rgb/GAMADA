{
  "name": "gamada",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "art:optimize": "node tools/optimize-svg.mjs",
    "art:build": "node tools/build-layers.mjs",
    "art": "npm run art:optimize && npm run art:build",
    "perf": "node tools/perf.mjs http://127.0.0.1:4173/ 4 1440 900 1.25",
    "ai:install": "npm --prefix server/ai-proxy install",
    "ai:mock": "npm --prefix server/ai-proxy run dev:mock",
    "ai:dev": "npm --prefix server/ai-proxy run dev",
    "ai:test": "npm --prefix server/ai-proxy test && npx tsx src/demo-kit/ai/__tests__/matcher.test.ts && npx tsx src/demo-kit/ai/__tests__/stream.test.ts && npx tsx src/demo-kit/ai/__tests__/fallback.test.ts && npx tsx src/demo-kit/ai/__tests__/structured-parity.test.ts && npx tsx src/demo-kit/ai/__tests__/proxy.integration.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-table": "^9.3.1",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "gsap": "^3.15.1",
    "idb-keyval": "^6.3.0",
    "lenis": "^1.3.27",
    "maplibre-gl": "^6.18.0",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.8"
  }
}
