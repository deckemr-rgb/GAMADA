# dependencies + build output (recreate with `npm install` / `npm run build`)
node_modules/
dist/
*.tsbuildinfo

# local scratch screenshots from development (docs/shots holds the curated ones)
.shots/

# logs / OS / editor noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# local env files (never commit secrets)
.env
.env.*
!.env.example

# Playwright e2e (npm run test:e2e): its own build + reports
.e2e/
test-results/
playwright-report/
